# This file is mounted ONLY into brian-room-admin. Keep it 0600.
NIMLET_ADMIN_DB_DSN=replace-with-existing-nimlet-operator-dsn
NIMLET_NAMESPACE=default
NIMLET_ADMIN_OPERATOR=agent-blocks/surfaces-v3
NIMLET_BINARY=/usr/local/bin/nimlet
ROOM_ADMIN_TOKEN=replace-with-same-exclusive-adapter-token
NIMLET_URL=http://nimlet:8080
AS_TOKEN=replace-with-existing-appservice-token
NIMLET_CONSUMER_TOKEN=replace-with-normal-bot-session-token
NIMLET_BOT_USERNAME=assistant-bot
