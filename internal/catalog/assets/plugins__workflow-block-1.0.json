{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow plugin view",
  "type": "object",
  "required": [
    "title",
    "status"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "enum": [
        "created",
        "running",
        "waiting",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "execution_id": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "waiting",
              "completed",
              "failed",
              "skipped",
              "cancelled"
            ]
          },
          "started_at": {
            "type": "string"
          },
          "finished_at": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "owner_id": {
      "type": "string"
    },
    "resolved_by": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
