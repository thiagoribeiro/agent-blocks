{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Notice block",
  "type": "object",
  "required": [
    "type",
    "level",
    "text"
  ],
  "properties": {
    "type": {
      "const": "notice"
    },
    "block_id": {
      "type": "string"
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "level": {
      "enum": [
        "info",
        "success",
        "warning",
        "error"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
