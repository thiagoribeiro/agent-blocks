{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Poll plugin view",
  "type": "object",
  "required": [
    "question",
    "status",
    "options"
  ],
  "properties": {
    "question": {
      "type": "string"
    },
    "status": {
      "enum": [
        "open",
        "closed",
        "cancelled"
      ]
    },
    "allow_multiple": {
      "type": "boolean"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "votes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    },
    "my_vote": {
      "type": [
        "string",
        "array",
        "null"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "owner_id": {
      "type": "string"
    },
    "resolved_by": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
