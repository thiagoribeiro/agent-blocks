{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plan plugin view",
  "type": "object",
  "required": [
    "title",
    "status",
    "steps"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "proposed",
        "approved",
        "running",
        "completed",
        "cancelled",
        "rejected"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
