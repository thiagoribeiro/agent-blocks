{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent LLM activity view",
  "type": "object",
  "required": [
    "title",
    "owner_id",
    "revision",
    "request_id",
    "sequence",
    "status",
    "current_status",
    "started_at",
    "updated_at",
    "heartbeat_at",
    "finished_at",
    "history",
    "active_activities",
    "history_total"
  ],
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 512
    },
    "owner_id": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "request_id": {
      "type": "string"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "running",
        "waiting_user",
        "completed",
        "failed",
        "interrupted"
      ]
    },
    "current_status": {
      "type": "string",
      "maxLength": 200
    },
    "started_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "heartbeat_at": {
      "type": "string"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "history": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "status",
          "started_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 160
          },
          "label": {
            "type": "string",
            "maxLength": 200
          },
          "status": {
            "enum": [
              "running",
              "completed",
              "failed",
              "interrupted"
            ]
          },
          "started_at": {
            "type": "string"
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "duration_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "active_activities": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "status",
          "started_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 160
          },
          "label": {
            "type": "string",
            "maxLength": 200
          },
          "status": {
            "enum": [
              "running",
              "completed",
              "failed",
              "interrupted"
            ]
          },
          "started_at": {
            "type": "string"
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "duration_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "history_total": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
