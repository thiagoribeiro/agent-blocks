  "plugins": [
    {
      "name": "approval",
      "version": "1.0",
      "description": "Human-in-the-loop approvals with approve/reject/cancel commands.",
      "stateful": true,
      "blocks": [
        {
          "type": "approval",
          "schema_ref": "schemas/plugins/approval-block-1.0.json"
        }
      ],
      "events": {
        "message": "m.ui.message",
        "command": "m.plugin.command",
        "state_updated": "m.plugin.state.updated",
        "instance_created": "m.plugin.instance.created"
      },
      "commands": [
        "approve",
        "reject",
        "cancel"
      ],
      "instance_creation": {
        "mode": "plugin_service_required",
        "operation": "ApprovalPlugin.create"
      },
      "fallback_required": true,
      "status": "experimental",
      "surfaces": {
        "default": "pinned",
        "auto_pin_when": [
          "pending"
        ],
        "auto_unpin_when": [
          "approved",
          "rejected",
          "cancelled",
          "expired"
        ],
        "supports_user_pin": true,
        "supports_focus_view": true
      },
      "purpose": "Human-in-the-loop approvals with approve/reject/cancel commands.",
      "when_to_use": "Human-in-the-loop approvals with approve/reject/cancel commands.",
      "state_ownership": "plugin",
      "fallback_rules": "Render fallback_markdown; never infer unsupported commands."
    },
