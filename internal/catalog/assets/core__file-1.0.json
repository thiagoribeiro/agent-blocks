{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "File block",
  "type": "object",
  "required": [
    "type",
    "url",
    "filename"
  ],
  "properties": {
    "type": {
      "const": "file"
    },
    "block_id": {
      "type": "string"
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "url": {
      "type": "string"
    },
    "filename": {
      "type": "string"
    },
    "mime_type": {
      "type": "string"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
