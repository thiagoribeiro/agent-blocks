{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Actions block",
  "type": "object",
  "required": [
    "type",
    "actions"
  ],
  "properties": {
    "type": {
      "const": "actions"
    },
    "block_id": {
      "type": "string"
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "event"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "style": {
            "enum": [
              "primary",
              "secondary",
              "danger",
              "link"
            ]
          },
          "disabled": {
            "type": "boolean"
          },
          "event": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
