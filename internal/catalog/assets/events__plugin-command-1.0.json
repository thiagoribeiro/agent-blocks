{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plugin command event content",
  "type": "object",
  "required": [
    "plugin",
    "instance_id",
    "command",
    "payload"
  ],
  "properties": {
    "plugin": {
      "type": "string"
    },
    "instance_id": {
      "type": "string"
    },
    "command": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    },
    "delegation": {
      "type": "object",
      "required": [
        "request_event_id",
        "request_room_seq"
      ],
      "properties": {
        "request_event_id": {
          "type": "string",
          "minLength": 1
        },
        "request_room_seq": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false,
  "dependentRequired": {
    "delegation": [
      "expected_revision"
    ]
  }
}
