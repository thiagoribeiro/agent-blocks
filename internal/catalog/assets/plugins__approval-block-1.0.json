{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approval plugin view",
  "type": "object",
  "required": [
    "title",
    "status"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired",
        "cancelled"
      ]
    },
    "approvers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approved_by": {
      "type": "string"
    },
    "rejected_by": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "owner_id": {
      "type": "string"
    },
    "resolved_by": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
