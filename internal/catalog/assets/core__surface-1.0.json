{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BRIAN surface hint",
  "type": "object",
  "properties": {
    "default": {
      "enum": [
        "timeline",
        "pinned",
        "modal",
        "panel",
        "archive"
      ]
    },
    "auto_pin": {
      "type": "boolean"
    },
    "priority": {
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ]
    },
    "dismissible": {
      "type": "boolean"
    },
    "expires_at": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
