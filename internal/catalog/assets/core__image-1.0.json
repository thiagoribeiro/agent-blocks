{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Image block",
  "type": "object",
  "required": [
    "type",
    "url"
  ],
  "properties": {
    "type": {
      "const": "image"
    },
    "block_id": {
      "type": "string"
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "url": {
      "type": "string"
    },
    "alt": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "mime_type": {
      "type": "string"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
