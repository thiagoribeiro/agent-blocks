{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Surface dismissed event content",
  "type": "object",
  "required": [
    "surface"
  ],
  "properties": {
    "surface": {
      "enum": [
        "pinned",
        "modal",
        "panel"
      ]
    },
    "plugin": {
      "type": "string"
    },
    "instance_id": {
      "type": "string"
    },
    "block_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
