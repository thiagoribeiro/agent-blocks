{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stateful form view",
  "type": "object",
  "required": [
    "title",
    "status",
    "fields",
    "values"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "invalid",
        "submitted",
        "cancelled"
      ]
    },
    "fields": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "enum": [
              "text",
              "number",
              "boolean",
              "select",
              "date"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "values": {
      "type": "object"
    },
    "errors": {
      "type": "object"
    },
    "owner_id": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": true
}
