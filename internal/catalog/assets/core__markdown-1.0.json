{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Markdown block",
  "type": "object",
  "required": [
    "type",
    "text"
  ],
  "properties": {
    "type": {
      "const": "markdown"
    },
    "block_id": {
      "type": "string"
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "text": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
